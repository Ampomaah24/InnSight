rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Keep existing users rule
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Allow all users to read available rooms
    match /rooms/{roomId} {
      allow read: if true; // Allows anyone to fetch rooms
      allow write: if request.auth != null; // Only logged-in users can modify
    }
    
    // Allow all users to read available conference rooms
    match /conference_rooms/{roomId} {
      allow read: if true; // Allows anyone to fetch conference rooms
      allow write: if request.auth != null; // Only logged-in users can modify
    }

    // Allow users to read and write their own room bookings
    match /roomBookings/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow users to read and write their own conference bookings
    match /conferenceBookings/{document=**} {
      allow read, write: if request.auth != null;
    }

    //  FIX: Add rules for the bookings collection
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }
    
    //  FIX: Allow authenticated users to read and write expenses (transactions)
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null; // Only authenticated users can read/write
    }
  }
}