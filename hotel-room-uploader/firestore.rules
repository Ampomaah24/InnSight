rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
  
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    
    match /rooms/{roomId} {
      allow read: if true; // Allows anyone to fetch rooms
      allow write: if request.auth != null; // Only logged-in users can modify
    }

    match /conference_rooms/{roomId} {
      allow read: if true; // Allows anyone to fetch conference rooms
      allow write: if request.auth != null; // Only logged-in users can modify
    }

    match /roomBookings/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /conferenceBookings/{document=**} {
      allow read, write: if request.auth != null;
    }


    match /bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }
    
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null; // Only authenticated users can read/write
    }
  }
}